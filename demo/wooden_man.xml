<mujoco model="wooden_man_with_joint">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.01"/>

  <worldbody>
    <!-- 地面 -->
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>
    <!-- 躯干 -->
    <body name="torso" pos="0 0 1.0">
      <geom name="torso_geom" type="capsule" fromto="0 0 1.0 0 0 1.5" size="0.1" rgba="1 0 0 1"/>

      <!-- 头 -->
      <body name="head" pos="0 0 1.6">
        <geom name="head_geom" type="sphere" size="0.15" rgba="1 0 0 1"/>
      </body>

      <!-- 左臂（加关节） -->
      <body name="left_arm" pos="-0.3 0 1.4">
        <joint name="left_shoulder" type="hinge" axis="0 0 1" pos="0 0 0"/>
        <geom name="left_arm_geom" type="capsule" fromto="0 0 0 -0.4 0 0" size="0.05" rgba="1 0 0 1"/>
      </body>

      <!-- 右臂（固定） -->
      <body name="right_arm" pos="0.3 0 1.4">
        <geom name="right_arm_geom" type="capsule" fromto="0 0 0 0.4 0 0" size="0.05" rgba="1 0 0 1"/>
      </body>

      <!-- 左腿 -->
      <body name="left_leg" pos="-0.1 0 0.5">
        <geom name="left_leg_geom" type="capsule" fromto="0 0 0 0 -0.5 0" size="0.08" rgba="1 0 0 1"/>
      </body>

      <!-- 右腿 -->
      <body name="right_leg" pos="0.1 0 0.5">
        <geom name="right_leg_geom" type="capsule" fromto="0 0 0 0 -0.5 0" size="0.08" rgba="1 0 0 1"/>
      </body>
    </body>
  </worldbody>

  <!-- 加上驱动器 -->
  <actuator>
    <motor name="left_arm_motor" joint="left_shoulder" ctrlrange="-1 1" gear="100"/>
  </actuator>
</mujoco>
